/target
/artifacts
# libfuzzer writes generated coverage corpus here on every run; only the small
# curated seed corpus is tracked (already committed). Ignore generated growth.
/corpus/*
# Keep the exact scheduled-fuzz reproducer for the repair round-trip gate while
# continuing to ignore libFuzzer's generated corpus growth.
!/corpus/rinex_qc_repair_roundtrip/
/corpus/rinex_qc_repair_roundtrip/*
!/corpus/rinex_qc_repair_roundtrip/regression-non-ascii-header-fixed-columns
!/corpus/rinex_qc_repair_roundtrip/regression-zero-interval-unknown
!/corpus/rinex_qc_repair_roundtrip/regression-over-width-obs-type-code
!/corpus/rinex_qc_repair_roundtrip/regression-phase-shift-exponent-width
!/corpus/rinex_qc_repair_roundtrip/regression-phase-shift-unwritable-satellites
# Same for the SP3 round-trip gate's committed reproducers.
!/corpus/sp3_round_trip/
/corpus/sp3_round_trip/*
!/corpus/sp3_round_trip/regression-corrupt-plus-slot-skip-count
!/corpus/sp3_round_trip/regression-r28-record-skip-count
!/corpus/sp3_round_trip/regression-over-precision-coordinate
!/corpus/sp3_round_trip/regression-over-precision-epoch-seconds
!/corpus/sp3_round_trip/regression-sp3-round-trip-no-comment.sp3
!/corpus/sp3_round_trip/regression-undeclared-sat-roundtrip
!/corpus/sp3_round_trip/valid-gbm-bds-trim.sp3
!/corpus/sp3_round_trip/valid-minimal-sp3c.sp3
# Same for the RTK gate's committed reproducers.
!/corpus/fuzz_rtk/
/corpus/fuzz_rtk/*
!/corpus/fuzz_rtk/all-inf-f64
!/corpus/fuzz_rtk/all-nan-f64
!/corpus/fuzz_rtk/empty
!/corpus/fuzz_rtk/lambda-outside-integer-domain
!/corpus/fuzz_rtk/single-byte
!/corpus/fuzz_rtk/valid-one-f64
!/corpus/fuzz_rtk/valid-zero-bytes
!/corpus/fuzz_rtk/regression-rover-position-overflow
!/corpus/fuzz_rtk/regression-antenna-pco-nonfinite
